<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CompressionEnabled>false</CompressionEnabled>
        <PublishTrimmed>false</PublishTrimmed>
        <RunAOTCompilation>false</RunAOTCompilation>

        <CompressionEnabled>false</CompressionEnabled>
        <WasmEnableHotReload>false</WasmEnableHotReload>
        <Authors>UniScanProject</Authors>
        <Copyright>UniScanProject</Copyright>
        <PackageProjectUrl>https://uniscan.dexrn.me</PackageProjectUrl>
        <RepositoryUrl>https://github.com/UniScanProject/UniScan</RepositoryUrl>
        <Company>UniScanProject</Company>
        <AssemblyVersion>0.1.0</AssemblyVersion>
        <FileVersion>0.1.0</FileVersion>
        <OutputType>Library</OutputType>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="Serilog" Version="4.4.0" />
      <PackageReference Include="Serilog.Sinks.Avalonia.Browser" Version="2.0.0" />
      <PackageReference Include="SpawnDev.SpawnJS" Version="2.1.8" />
      <PackageReference Include="SpawnDev.SpawnJS.WebWorkers" Version="2.1.8" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\UniScan.Platform\UniScan.Platform.csproj" />
    </ItemGroup>
</Project>
