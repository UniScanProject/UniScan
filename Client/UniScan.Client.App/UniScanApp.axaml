<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UniScan.Client.App.UniScanApp"
             RequestedThemeVariant="Default"
             xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
             xmlns:ui="clr-namespace:UniScan.Client.App.UI"
             xmlns:conversion="clr-namespace:UniScan.Client.App.UI.Conversion"
             Name="UniScan">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <ui:ViewLocator/>
    </Application.DataTemplates>
             
             <Application.Resources>
                 <conversion:RelativeUnitConverter x:Key="RelativeUnitConverter"/>
             </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <dialogHostAvalonia:DialogHostStyles />
    </Application.Styles>
</Application>