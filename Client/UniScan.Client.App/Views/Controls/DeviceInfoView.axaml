<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:UniScan.Client.App.ViewModels.Controls"
             xmlns:controls1="clr-namespace:UniScan.Client.App.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Controls.DeviceInfoView"
             x:DataType="controls1:DeviceInfoViewModel">
    <Border Name="DeviceCard" Background="{DynamicResource ButtonBackground}" Padding="5" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource ButtonBorderBrush}">
        <Grid RowDefinitions="Auto, *, Auto" RowSpacing="5">
            <TextBlock DockPanel.Dock="Top" Grid.Row="0" HorizontalAlignment="Center" Text="{Binding Info.DisplayName}" FontWeight="Bold" />
            
            <Border Grid.Row="1" BorderThickness="2" BorderBrush="{DynamicResource ButtonBorderBrushPointerOver}" CornerRadius="5">
                <StackPanel Spacing="10">
                    <TextBlock Text="Not subscribed" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="DemiBold" />
                    <Button Command="{Binding SubscribeCommand}" VerticalAlignment="Center" HorizontalAlignment="Center">Subscribe</Button>
                </StackPanel>
            </Border>
            
            <Grid DockPanel.Dock="Bottom" Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding $parent[Border].((controls1:DeviceInfoViewModel)DataContext)?.HasModelInfo}" Spacing="2">
                        <TextBlock Text="{Binding Info.Specs?.Model}" />
                        <TextBlock Text="{Binding Info.Specs?.Version}" FontSize="12" Foreground="{DynamicResource TextControlForegroundDisabled}" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextControlForegroundDisabled}" FontSize="12" Text="{Binding Info.ScannerIdentifier}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
