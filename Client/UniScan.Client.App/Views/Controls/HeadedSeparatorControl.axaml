<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:UniScan.Client.App.Views.Controls"
             xmlns:controls="clr-namespace:UniScan.Client.App.Views.Controls"
             xmlns:local1="clr-namespace:UniScan.Client.App.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Controls.HeadedSeparatorControl">
    <Grid ColumnDefinitions="Auto, *">
        <TextBlock Grid.Column="0" Text="{Binding $parent[local1:HeadedSeparatorControl].Text}" VerticalAlignment="Center"/>
        <Separator Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,1,1,1"/>
    </Grid>
</UserControl>
