<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UniScan.Client.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:UniScan.Client.App.ViewModels.Controls"
             xmlns:controls1="clr-namespace:UniScan.Client.App.Views.Controls"
             xmlns:pages1="clr-namespace:UniScan.Client.App.ViewModels.Pages"
             xmlns:controls2="clr-namespace:UniScan.Client.App.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Pages.MainRemotePageView"
             x:DataType="pages1:MainRemotePageViewModel">
        <SplitView IsPaneOpen="True"
                   DisplayMode="Inline"
                   OpenPaneLength="100"
                   PanePlacement="Right">
            <SplitView.Pane>
                <StackPanel>
                <TextBlock Text="Remotes" FontStyle="Oblique" />
                <!-- <ItemsControl x:Name="RemotesList" ItemsSource="{Binding DevicesView}"> -->
                <!--     <ItemsControl.ItemTemplate> -->
                <!--         <controls:DeviceInfoViewModelTemplate ParentRemote="{Binding #RemotesList.((pages:MainRemotePageViewModel)DataContext)?.Remote}" /> -->
                <!--     </ItemsControl.ItemTemplate> -->
                <!--          -->
                <!--     <ItemsControl.Styles> -->
                <!--         <Style Selector="controls1|DeviceSidebarView"> -->
                <!--             <Setter Property="FlyoutBase.AttachedFlyout"> -->
                <!--                 <MenuFlyout> -->
                <!--                 </MenuFlyout> -->
                <!--             </Setter> -->
                <!--                  -->
                <!--             <Setter Property="ContextFlyout" Value="{Binding (FlyoutBase.AttachedFlyout), RelativeSource={RelativeSource Self}}" /> -->
                <!--         </Style> -->
                <!--     </ItemsControl.Styles> -->
                <!-- </ItemsControl> -->
                </StackPanel>
            </SplitView.Pane>
            
            <SplitView.Content>
                <controls2:DeviceListView DataContext="{Binding DeviceList}" />
            </SplitView.Content>
        </SplitView>
</UserControl>
