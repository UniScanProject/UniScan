<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UniScan.Client.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:UniScan.Client.App.ViewModels.Controls"
             xmlns:controls1="clr-namespace:UniScan.Client.App.Views.Controls"
             xmlns:pages1="clr-namespace:UniScan.Client.App.ViewModels.Pages"
             xmlns:controls2="clr-namespace:UniScan.Client.App.Views.Controls"
             xmlns:conversion="clr-namespace:UniScan.Client.App.UI.Conversion"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Pages.MainRemotePageView"
             x:DataType="pages1:MainRemotePageViewModel">
        <SplitView IsPaneOpen="True"
                   DisplayMode="Inline"
                   OpenPaneLength="100"
                   PanePlacement="Right">
            <SplitView.Pane>
                <StackPanel>
                <TextBlock Text="Remotes" FontStyle="Oblique" />
                <!-- <ItemsControl x:Name="RemotesList" ItemsSource="{Binding DevicesView}"> -->
                <!--     <ItemsControl.ItemTemplate> -->
                <!--         <controls:DeviceInfoViewModelTemplate ParentRemote="{Binding #RemotesList.((pages:MainRemotePageViewModel)DataContext)?.Remote}" /> -->
                <!--     </ItemsControl.ItemTemplate> -->
                <!--          -->
                <!--     <ItemsControl.Styles> -->
                <!--         <Style Selector="controls1|DeviceSidebarView"> -->
                <!--             <Setter Property="FlyoutBase.AttachedFlyout"> -->
                <!--                 <MenuFlyout> -->
                <!--                 </MenuFlyout> -->
                <!--             </Setter> -->
                <!--                  -->
                <!--             <Setter Property="ContextFlyout" Value="{Binding (FlyoutBase.AttachedFlyout), RelativeSource={RelativeSource Self}}" /> -->
                <!--         </Style> -->
                <!--     </ItemsControl.Styles> -->
                <!-- </ItemsControl> -->
                </StackPanel>
            </SplitView.Pane>
            
            <SplitView.Content>
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"> -->
                    <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Margin="5" CornerRadius="10" IsVisible="{Binding RemoteInfoViewModel, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <controls1:RemoteInfoView DataContext="{Binding RemoteInfoViewModel}" />
                    </Border>
                    <!-- </Expander> -->
                    <controls2:DeviceListView Grid.Row="1" DataContext="{Binding DeviceList}" />
                    
                    <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Margin="5" Padding="10" CornerRadius="5" IsVisible="{Binding Remote.RemoteInfo.CurrentValue?.Social.MessageOfTheDay, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding Remote.RemoteInfo.CurrentValue?.Social.MessageOfTheDay}" />
                    </Border>
                </Grid>
            </SplitView.Content>
        </SplitView>
</UserControl>
