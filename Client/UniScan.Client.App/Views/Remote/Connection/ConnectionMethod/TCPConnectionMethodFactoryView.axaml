<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:connectionMethod1="clr-namespace:UniScan.Client.App.Views.Remote.Connection.ConnectionMethod"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Remote.Connection.ConnectionMethod.TCPConnectionMethodFactoryView"
             x:DataType="connectionMethod1:TCPConnectionMethodFactoryViewModel">
    <StackPanel>
        
        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" HorizontalAlignment="Stretch">
            <StackPanel Spacing="5">
                <TextBlock Text="IP Address" />
                <TextBox Text="{Binding Address}" PlaceholderText="127.0.0.1" MaxLines="1" AcceptsReturn="False" VerticalAlignment="Center"  />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Port" />
                <TextBox Text="{Binding Port}" PlaceholderText="9000" MaxLines="1" AcceptsReturn="False" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
