<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:UniScan.Client.App.ViewModels"
             xmlns:viewModels1="clr-namespace:UniScan.Client.App.ViewModels"
             xmlns:viewModels2="clr-namespace:UniScan.Client.App.ViewModels"
             xmlns:app="clr-namespace:UniScan.Client.App"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.LoadingView"
             x:DataType="viewModels2:LoadingViewModel">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <Image Source="../Assets/logo_512x512.png" Width="128" Height="128" VerticalAlignment="Top" Margin="0 0 0 10" />
            <TextBlock>Loading...</TextBlock>
            
            <TextBlock Text="{Binding App.LoadPipeline.Pipeline.Status.Value}"/>
            <ProgressBar Value="{Binding App.LoadPipeline.Pipeline.Progress.Value}" />
        </StackPanel>
        
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Spacing="10">
            <TextBlock Text="{Binding Source={x:Static viewModels:LoadingViewModel.VersionString}}" />
        </StackPanel>
    </Grid>
</UserControl>
