<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <LangVersion>14</LangVersion>
        <Company>UniScanProject</Company>
        <AssemblyVersion>0.0.2</AssemblyVersion>
        <FileVersion>0.0.2</FileVersion>
        <Configurations>Debug;Release;Debug Server;Debug Client;Release Server;Release Client;Release App;Debug App</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <OutputPath>bin\Debug/net10.0</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <OutputPath>bin\Release/net10.0</OutputPath>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack"/>
        <PackageReference Include="R3"/>
        <PackageReference Include="Semver"/>
        <PackageReference Include="Serilog"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="System.IO.Ports"/>
        <ProjectReference Include="..\..\..\external\Shiki\src\CodeGenerator\Shiki.CodeGenerator\Shiki.CodeGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\external\Shiki\src\Extensions\Shiki.Extensions.MessagePack\Shiki.Extensions.MessagePack.csproj"/>
        <ProjectReference Include="..\..\..\external\Shiki\src\Shiki.Common\Shiki.Common.csproj"/>
        <ProjectReference Include="..\..\..\external\Shiki\src\Shiki.Internationalization\Shiki.Internationalization.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BidirectionalDictionary">
            <HintPath>..\..\..\..\..\..\..\.nuget\packages\bidirectionaldictionary\3.1.5\lib\net9.0\BidirectionalDictionary.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Assets\**\*" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Settings\" />
    </ItemGroup>
</Project>
