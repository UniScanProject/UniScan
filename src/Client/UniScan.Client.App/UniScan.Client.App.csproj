    <!-- THIS TOOK SO FUCKING LONG TO GET WORKING MY GOD -->
    <ItemGroup Condition="'$(UniScanPlatform)' == 'browser'">
        <Compile Remove="Views\Remote\Connection\ConnectionMethod\TCPConnectionMethodFactoryView.axaml.cs" />
        <Compile Remove="Views\Remote\Connection\ConnectionMethod\TCPConnectionMethodFactoryView.axaml" />
        <Compile Remove="Views\Remote\Connection\ConnectionMethod\TCPConnectionMethodFactoryViewModel.cs" />
        
        <AvaloniaXaml Remove="Views\Remote\Connection\ConnectionMethod\TCPConnectionMethodFactoryView.axaml" />
    </ItemGroup>

    <Target Name="ClientDownloadMaterialSymbols" BeforeTargets="BeforeBuild;GenerateAvaloniaResources">
        <Warning Text="SolutionDir is empty... won't download materialsymbols"
                 Condition="'$(SolutionDir)' == '' OR '$(SolutionDir)' == '*Undefined*'" />
        
        <Exec Command="dotnet run --file 'scripts/PullMaterialIcons.cs'" WorkingDirectory="$(SolutionDir)" Condition="'$(SolutionDir)' != '' AND '$(SolutionDir)' != '*Undefined*'" />
    </Target>
