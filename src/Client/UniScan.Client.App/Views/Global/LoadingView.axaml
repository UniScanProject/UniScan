<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:global="clr-namespace:UniScan.Client.App.Views.Global"
             xmlns:app="clr-namespace:UniScan.Client.App"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Global.LoadingView"
             x:DataType="global:LoadingViewModel">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <Image Source="/Assets/logo_128x128.png" Width="128" Height="128" VerticalAlignment="Top" Margin="0 0 0 10" />
            <TextBlock Text="{Binding LoadingText}" />
            
            <TextBlock Text="{Binding TaskPipeline.Status.Value}"/>
            <ProgressBar Value="{Binding TaskPipeline.Progress.Value}" />
        </StackPanel>
        
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Spacing="10">
            <TextBlock Text="{Binding Source={x:Static app:UniScanApp.VersionString}}" />
        </StackPanel>
    </Grid>
</UserControl>
