<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             xmlns:connection="clr-namespace:UniScan.Client.App.Views.Remote.Connection"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Remote.Connection.NotConnectedRemotePageView"
             x:DataType="connection:NotConnectedRemotePageViewModel">
    <Border VerticalAlignment="Center" HorizontalAlignment="Center" Padding="10" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="10">
        <StackPanel Spacing="10">
            <Border Padding="10" CornerRadius="5" Background="{DynamicResource SystemControlPageBackgroundBaseLowBrush}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Image VerticalAlignment="Center" asyncImageLoader:ImageLoader.Source="{Binding RemoteViewModel.Remote.RemoteInfo.CurrentValue?.Branding.LogoUrl}" Width="32" Height="32" IsVisible="{Binding RemoteViewModel.Remote.RemoteInfo.CurrentValue?.Branding.LogoUrl, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False, TargetNullValue=False}" />
                    <TextBlock Text="{Binding RemoteViewModel.Remote.DisplayName}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock Text="Not connected" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" FlowDirection="RightToLeft" Margin="0 10 0 0">
                <Button Content="Connect" IsEnabled="{Binding HasConnectionMethod}" Command="{Binding ConnectCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
