<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:UniScan.Client.App.Views"
             xmlns:conversion="clr-namespace:UniScan.Client.App.UI.Conversion"
             xmlns:action="clr-namespace:UniScan.Client.App.Views.Remote.Action"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Remote.Action.AddRemoteDialogView"
             x:DataType="action:AddRemoteDialogViewModel"
             Width="{Binding $parent[views:MainView].Bounds.Width, Converter={conversion:RelativeUnitConverter Min=200, Percentage=0.50}}"
             Height="{Binding $parent[views:MainView].Bounds.Height, Converter={conversion:RelativeUnitConverter Min=200, Percentage=0.50}}"
             Padding="6">
    <Grid RowDefinitions="*, Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Text="Connection Method"></TextBlock>
                
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch">
                    <ComboBox ItemsSource="{Binding ViewModels}" SelectedItem="{Binding SelectedMethodFactory}" HorizontalAlignment="Stretch" PlaceholderText="Choose a connection method">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Attribute.DisplayName}"></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="10" IsVisible="{Binding HasMethodFactory}">
                    <ContentControl Content="{Binding CurrentMethodFactory}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>


        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Grid.Row="1">
            <Button Content="Confirm" Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding CurrentMethodFactory.IsValid, FallbackValue=False, TargetNullValue=False}" Background="{DynamicResource AccentButtonBackground}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>