<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:UniScan.Client.App"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Settings.ClientSettingsView">
    <Grid>
        <TextBlock Text="Coming soon" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" />
        <Border Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Source={x:Static app:UniScanApp.VersionString}}" />
        </Border>
    </Grid>
</UserControl>
