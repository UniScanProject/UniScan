<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:UniScan.Client.App.Views.Settings.Pages"
             xmlns:properties="clr-namespace:UniScan.Client.App.UI.Properties"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="UniScan.Client.App.Views.Settings.Pages.SettingsEmptyPageView"
             x:DataType="pages:SettingsEmptyPageViewModel">
    <Border Padding="5">
        <TextBlock properties:TextBlockTranslationTextComponentProperty.TranslationId="UniScan:client/i18n/settings/page/empty/no_options" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" />
    </Border>
</UserControl>
